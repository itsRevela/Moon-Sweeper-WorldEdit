<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MoonWorldEdit</AssemblyName>
    <RootNamespace>MoonWorldEdit.Plugin</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BepInExDir>$(MoonSweepersDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- Compile against the loader (installed by Moon Sweeper Mahjong) and the game's interop assemblies in place; the
       game supplies them at run time. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoonWorldEdit.Core\MoonWorldEdit.Core.csproj" />
  </ItemGroup>

  <!-- dotnet build -p:DeployToGame=true copies the mod into its own plugins folder (replaced wholesale each time). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <PluginDeployDir>$(BepInExDir)\plugins\MoonWorldEdit</PluginDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <ModFiles Include="$(OutDir)MoonWorldEdit*.dll;$(OutDir)MoonWorldEdit*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="DEPLOY OK: @(ModFiles->Count()) files to $(PluginDeployDir)" />
  </Target>

</Project>
